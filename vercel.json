{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/",
      "destination": "https://turboism.dev/thanks",
      "permanent": true
    },
    {
      "source": "/contributors.json",
      "destination": "https://turboism.dev/thanks/contributors.json",
      "permanent": true
    }
  ]
}
